      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}"
    },

    {
      "name": "Debugger Python: File corrente",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debugger Python: start MCP",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\desktop_mcp\\main.py",
      "console": "integratedTerminal"
    }
  ]
